{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "predeploy": ["node scripts/check-fomo-links.mjs"],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      ".git/**",
      ".firebase/**",
      "**/node_modules/**",
      "**/*.log",
      "bijanizadian.com.txt",
      "brand/**",
      "fomo-handoff/**",
      "fomo-handoff.zip",
      "preview-final.html",
      "scripts/**",
      "AGENTS.md",
      "DISCORD.md",
      "database.rules.json",
      "portfolio/**",
      "fomo-hq-portal/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/hq",
        "destination": "https://fomo-hq-visits.lebron2423.chatgpt.site",
        "type": 302
      },
      {
        "source": "/hq/**",
        "destination": "https://fomo-hq-visits.lebron2423.chatgpt.site",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/desktop.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|svg|png|jpg|jpeg|webp|woff2|pdf|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  }
}
