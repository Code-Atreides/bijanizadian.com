{
  "rules": {
    "sheets": {
      "$code": {
        ".read": true,
        ".write": true
      }
    },
    "intake": {
      ".read": false,
      "$key": {
        ".write": "!data.exists()",
        ".validate": "$key.matches(/^submissions:[0-9]+-[a-z0-9]{1,8}$/) && newData.isString() && newData.val().length <= 20000"
      }
    },
    "dinners": {
      ".read": false,
      "$key": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['first_name', 'last_name', 'email', 'phone', 'instagram', 'school', 'city', 'host_type', 'guests', 'why', 'submitted_at']) && newData.child('email').val().length < 200 && newData.child('guests').val().length < 4000 && newData.child('why').val().length < 4000"
      }
    },
    "campus": {
      ".read": false,
      "$key": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['first_name', 'last_name', 'email', 'phone', 'instagram', 'school', 'role', 'why', 'submitted_at']) && newData.child('email').val().length < 200 && newData.child('why').val().length < 4000"
      }
    },
    "icybox_creators": {
      ".read": false,
      "$key": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['first_name', 'last_name', 'email', 'phone', 'school', 'chapter', 'instagram', 'age_ok', 'submitted_at']) && newData.child('age_ok').val() == true && newData.child('email').val().length < 200 && newData.child('school').val().length < 200 && newData.child('chapter').val().length < 200 && newData.child('instagram').val().length < 80 && (!newData.hasChild('video_link') || newData.child('video_link').val().length < 400)"
      }
    },
    "greekwars": {
      ".read": true,
      ".write": false
    },
    "greekwars_onboard": {
      ".read": false,
      "$key": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['first_name','last_name','email','phone','instagram','school','org_type','chapter','role','actives','best_trader','submitted_at']) && newData.child('email').val().length < 200 && newData.child('school').val().length < 200 && newData.child('chapter').val().length < 200 && newData.child('best_trader').val().length < 200"
      }
    },
    "greekwars_clans": {
      "$clan": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "$clan.matches(/^[a-z0-9-]{3,48}$/) && newData.hasChildren(['chapter','school','created_at']) && (newData.hasChild('lead') || newData.child('kind').val() == 'claim')",
        "chapter": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 120" },
        "school": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 120" },
        "lead": {
          ".write": "root.child('greekwars_clan_keys').child($clan).exists() && newData.parent().parent().parent().child('greekwars_clan_heads').child($clan).child(root.child('greekwars_clan_keys').child($clan).val()).child('lead').val() == newData.val()",
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_.-]{2,32}$/)"
        },
        "kind": { ".validate": "newData.val() == 'claim'" },
        "actives": { ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 1000" },
        "created_at": { ".validate": "newData.val() == now" },
        "$other": { ".validate": false }
      }
    },
    "greekwars_clan_leads": {
      ".read": false,
      "$clan": {
        ".write": "!data.exists() && newData.parent().parent().child('greekwars_clans').child($clan).exists()",
        ".validate": "newData.hasChildren(['first_name','last_name','email','fomo_username','referral_link','school','chapter','actives','submitted_at']) && newData.child('fomo_username').val() == newData.parent().parent().child('greekwars_clans').child($clan).child('lead').val()",
        "first_name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" },
        "last_name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/)" },
        "phone": { ".validate": "newData.isString() && newData.val().length >= 7 && newData.val().length <= 30 && newData.val().matches(/^[+()0-9 .-]+$/)" },
        "fomo_username": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_.-]{2,32}$/)" },
        "referral_link": { ".validate": "newData.isString() && newData.val() == 'https://fomo.family/r/' + newData.parent().child('fomo_username').val()" },
        "school": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 120" },
        "chapter": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 120" },
        "actives": { ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 1000" },
        "submitted_at": { ".validate": "newData.val() == now" },
        "$other": { ".validate": false }
      }
    },
    "greekwars_clan_members": {
      ".read": false,
      "$clan": {
        "$member": {
          ".write": "!data.exists() && root.child('greekwars_clans').child($clan).exists()",
          ".validate": "newData.hasChildren(['fomo_username','submitted_at']) && (newData.hasChildren(['first_name','last_name','email']) || root.child('greekwars_clans').child($clan).child('kind').val() == 'claim') && $member == newData.child('fomo_username').val().toLowerCase().replace('.', ',')",
          "first_name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" },
          "last_name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/)" },
          "fomo_username": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_.-]{2,32}$/)" },
          "submitted_at": { ".validate": "newData.val() == now" },
          "$other": { ".validate": false }
        }
      }
    },
    "greekwars_clan_roster": {
      "$clan": {
        ".read": true,
        "$member": {
          ".write": "!data.exists() && newData.parent().parent().parent().child('greekwars_clan_members').child($clan).child($member).exists()",
          ".validate": "newData.val() == true"
        }
      }
    },
    "greekwars_clan_heads": {
      "$clan": {
        "$token": {
          ".write": "root.child('greekwars_clan_keys').child($clan).val() == $token",
          ".validate": "newData.hasChildren(['lead','referral_link','updated_at'])",
          "lead": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_.-]{2,32}$/)" },
          "referral_link": { ".validate": "newData.isString() && newData.val() == 'https://fomo.family/r/' + newData.parent().child('lead').val()" },
          "updated_at": { ".validate": "newData.val() == now" },
          "$other": { ".validate": false }
        }
      }
    },
    "greekwars_claimlinks": {
      "$code": {
        ".read": true
      }
    },
    "content_submissions": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email == 'izadianbijan@gmail.com'",
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (!newData.exists() && auth != null && auth.token.email_verified == true && auth.token.email == 'izadianbijan@gmail.com')",
        ".validate": "$id.matches(/^[a-z0-9]{8,10}-[a-z0-9]{6}$/) && newData.hasChildren(['name','email','school','link','title','submitted_at'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/)" },
        "school": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 120" },
        "handle": { ".validate": "newData.isString() && newData.val().matches(/^@[A-Za-z0-9_.]{1,30}$/)" },
        "link": { ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().matches(/^https:[/][/][^ ]+$/)" },
        "title": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 120" },
        "notes": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "challenge": { ".validate": "newData.isString() && newData.val().matches(/^bar-fall-2026$/)" },
        "submitted_at": { ".validate": "newData.val() == now" },
        "$other": { ".validate": false }
      }
    },
    "content_status": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email == 'izadianbijan@gmail.com'",
      "$id": {
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email == 'izadianbijan@gmail.com'",
        ".validate": "newData.hasChildren(['status','updated_at']) && root.child('content_submissions').child($id).exists()",
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(editing|done)$/)" },
        "updated_at": { ".validate": "newData.val() == now" },
        "$other": { ".validate": false }
      }
    },
    "content_posts": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email == 'izadianbijan@gmail.com'",
      ".write": "auth != null && auth.token.email_verified == true && auth.token.email == 'izadianbijan@gmail.com'",
      "$post": {
        ".validate": "$post.matches(/^[a-z0-9]{8,10}-[a-z0-9]{6}$/) && newData.hasChildren(['url','platform','title','posted_at','latest'])",
        "url": {
          ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().matches(/^https:[/][/][^ ]+$/)"
        },
        "platform": {
          ".validate": "newData.isString() && newData.val().matches(/^(tiktok|instagram|youtube|x|other)$/)"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
        },
        "creator": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "school": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "submission": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{8,10}-[a-z0-9]{6}$/)"
        },
        "state": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{2}$/)"
        },
        "source": {
          ".validate": "newData.val() == 'brightdata'"
        },
        "external_id": {
          ".validate": "newData.isString() && newData.val().matches(/^(tiktok|instagram):[A-Za-z0-9_-]{5,40}$/)"
        },
        "creator_id": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{8,10}-[a-z0-9]{6}$/)"
        },
        "hashtags": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "caption": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 4000"
        },
        "posted_at": {
          ".validate": "newData.isNumber() && newData.val() >= 1577836800000 && newData.val() <= now + 86400000"
        },
        "created_at": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "latest": {
          ".validate": "newData.hasChildren(['at'])",
          "views": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000 && newData.val() % 1 == 0"
          },
          "likes": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000 && newData.val() % 1 == 0"
          },
          "comments": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000 && newData.val() % 1 == 0"
          },
          "shares": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000 && newData.val() % 1 == 0"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() >= 1577836800000 && newData.val() <= now + 86400000"
          },
          "$other": {
            ".validate": false
          }
        },
        "snapshots": {
          "$snap": {
            ".validate": "$snap.matches(/^[a-z0-9-]{6,24}$/) && newData.hasChildren(['at'])",
            "views": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000 && newData.val() % 1 == 0"
            },
            "likes": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000 && newData.val() % 1 == 0"
            },
            "comments": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000 && newData.val() % 1 == 0"
            },
            "shares": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000 && newData.val() % 1 == 0"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() >= 1577836800000 && newData.val() <= now + 86400000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "content_creators": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email == 'izadianbijan@gmail.com'",
      ".write": "auth != null && auth.token.email_verified == true && auth.token.email == 'izadianbijan@gmail.com'",
      "$creator": {
        ".validate": "$creator.matches(/^[a-z0-9]{8,10}-[a-z0-9]{6}$/) && newData.hasChildren(['name','created_at'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
        "school": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "state": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{2}$/)" },
        "tiktok": { ".validate": "newData.isString() && newData.val().matches(/^https:[/][/]www[.]tiktok[.]com[/]@[A-Za-z0-9._]{2,24}$/)" },
        "instagram": { ".validate": "newData.isString() && newData.val().matches(/^https:[/][/]www[.]instagram[.]com[/][A-Za-z0-9._]{1,30}[/]$/)" },
        "active": { ".validate": "newData.isBoolean()" },
        "created_at": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "last_checked_at": { ".validate": "newData.isNumber()" },
        "tiktok_result": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "instagram_result": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "last_error": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "followers": {
          "$platform": {
            ".validate": "$platform.matches(/^(tiktok|instagram)$/) && newData.hasChildren(['count','at'])",
            "count": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000000 && newData.val() % 1 == 0" },
            "at": { ".validate": "newData.isNumber() && newData.val() >= 1577836800000 && newData.val() <= now + 86400000" },
            "$other": { ".validate": false }
          }
        },
        "followers_log": {
          "$platform": {
            ".validate": "$platform.matches(/^(tiktok|instagram)$/)",
            "$day": { ".validate": "$day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000000 && newData.val() % 1 == 0" }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "content_sync": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email == 'izadianbijan@gmail.com'",
      ".write": false
    },
    "content_tags": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email == 'izadianbijan@gmail.com'",
      ".write": "auth != null && auth.token.email_verified == true && auth.token.email == 'izadianbijan@gmail.com'",
      "$scope": {
        ".validate": "$scope.matches(/^(all|region-(west|midwest|south|northeast)|topic-[a-z0-9-]{2,30})$/) && newData.isString() && newData.val().length <= 1000"
      }
    },
    "agencykitWorkspace": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email == 'izadianbijan@gmail.com'",
      ".write": "auth != null && auth.token.email_verified == true && auth.token.email == 'izadianbijan@gmail.com' && newData.exists()",
      ".validate": "newData.hasChildren(['payload', 'revision', 'updatedBy', 'updatedAt']) && ((!data.exists() && newData.child('revision').val() == 1) || (data.exists() && newData.child('revision').val() == data.child('revision').val() + 1))",
      "payload": {
        ".validate": "newData.isString() && newData.val().length <= 4194304"
      },
      "revision": {
        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 == 0"
      },
      "updatedBy": {
        ".validate": "newData.isString() && newData.val() == auth.uid"
      },
      "updatedAt": {
        ".validate": "newData.isNumber() && newData.val() == now"
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
